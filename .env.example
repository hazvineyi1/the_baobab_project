# Railway sets this automatically once you add a PostgreSQL database and
# reference it on this service (see README.md). For local testing you can
# point it at any Postgres instance, or leave it unset entirely — the app
# will still run, just without persistence between restarts.
DATABASE_URL=

# Railway sets this automatically too — you generally never need to touch it.
PORT=3000

# THE KEEPER'S PASSPHRASE. This one is yours, not any family's.
#
# It opens the dashboard at /admin — where you issue families their passcodes,
# read the record of who did what, and answer appeals — and it opens NO
# family's tree. There is no endpoint that would let it.
#
# Without it the dashboard is off and no family passcodes can be issued, and a
# deployment that has a database and neither this nor APP_PASSPHRASE refuses
# to serve anything rather than serving it openly.
MW_ADMIN_PASSPHRASE=

# The OLD deployment-wide passphrase, from before families had their own.
#
# It still opens the HOME family, so that nobody was signed out when passcodes
# came in. New families do not use it: each has its own passcode, issued from
# /admin and shown once. You can leave this unset on a new deployment.
APP_PASSPHRASE=

# NEVER commit a real value for either of the two above. This file is an
# example and is in the repository; the real secrets belong only in the
# deployment's environment variables (on Railway: the service's Variables tab).
#
# A family's passcode is not here and cannot be: it is generated by the server,
# shown to the keeper once, and stored only as a scrypt hash. Nobody can read
# one back — a lost passcode is replaced, never recovered.

# Whether the public record is reachable by the public.
#
# OFF by default, and a separate switch on purpose: turning it on is the
# moment this deployment starts publishing ancestors to the world, and that
# should be done deliberately rather than as a side effect of a deploy.
#
# What it exposes is only ever what mw_is_public() allows: the dead, plus any
# living person who has chosen to be published. Never a private person, and
# never the family's working record — no note of who entered whom, no
# set-aside reasons, no timestamps.
MW_PUBLIC_READ=off
