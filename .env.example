# Railway sets this automatically once you add a PostgreSQL database and
# reference it on this service (see README.md). For local testing you can
# point it at any Postgres instance, or leave it unset entirely — the app
# will still run, just without persistence between restarts.
DATABASE_URL=

# Railway sets this automatically too — you generally never need to touch it.
PORT=3000

# The shared passphrase for this deployment. Everyone in the family types this
# once; the browser then holds a signed session for 30 days.
#
# NEVER commit a real value. This file is an example and is in the repository;
# the real passphrase belongs only in the deployment's environment variables
# (on Railway: the service's Variables tab).
#
# Without it, a deployment that has a database refuses to serve the tree
# rather than serving it openly. Locally, with no database, the gate is off.
APP_PASSPHRASE=
